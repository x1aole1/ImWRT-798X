Run [ -e $FEEDS_CONF ] && mv $FEEDS_CONF openwrt/feeds.conf.default
  [ -e $FEEDS_CONF ] && mv $FEEDS_CONF openwrt/feeds.conf.default
  [ -e files ] && mv files openwrt/files
  [ -e $CONFIG_FILE ] && mv $CONFIG_FILE openwrt/.config
  echo "CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y" >> openwrt/.config
  cd openwrt
  chmod +x $GITHUB_WORKSPACE/$DIY_P1_SH $GITHUB_WORKSPACE/$DIY_P2_SH
  $GITHUB_WORKSPACE/$DIY_P1_SH
  ./scripts/feeds update -a && ./scripts/feeds install -a
  $GITHUB_WORKSPACE/$DIY_P2_SH
  
  # 注入 cmcc_rax3000m-emmc (U-Boot mod，输出 sysupgrade.itb)
  python3 $GITHUB_WORKSPACE/scripts/inject-emmc-device.py
  grep -A3 "^define Device/cmcc_rax3000m-emmc$" target/linux/mediatek/image/filogic.mk || { echo "ERROR: 设备定义注入失败"; exit 1; }
  
  make defconfig
  grep -q "^CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y" .config || { echo "ERROR: 注入的设备定义未被 Kconfig 解析，请检查 filogic.mk"; exit 1; }
  grep -c "DEVICE_cmcc_rax3000m-emmc" .config
  make download -j8 || make download -j1 V=s
  shell: /usr/bin/bash -e {0}
  env:
    REPO_URL: https://github.com/padavanonly/immortalwrt-mt798x-24.10
    REPO_BRANCH: openwrt-24.10-6.6
    FEEDS_CONF: feeds.conf.default
    CONFIG_FILE: 24.10-6.6.config
    DIY_P1_SH: scripts/diy-part1.sh
    DIY_P2_SH: scripts/diy-part2.sh
    DEVICE_CODE: cmcc_rax3000m-emmc
    UPLOAD_FIRMWARE: true
    UPLOAD_RELEASE: true
    TZ: Asia/Shanghai
    WEBDAV_URL: 
    WEBDAV_USERNAME: 
    WEBDAV_PASSWORD: 
    ENABLE_5G_25DB: true
    export PATH: /usr/lib/ccache:$PATH
    export CCACHE_DIR: $HOME/.ccache
